{
  "name": "contador-trafego",
  "productName": "Contador de Tráfego",
  "desktopName": "contador-trafego.desktop",
  "version": "0.1.0",
  "description": "Contagem de ciclistas, pedestres e veículos com revisão humana",
  "author": "Rafael Schettino <rcschettino@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev": "CONTADOR_DESKTOP_URL=http://127.0.0.1:3000 electron .",
    "preparar": "node scripts/preparar.mjs",
    "iniciar": "electron .",
    "dist": "npm run preparar && electron-builder",
    "dist:win": "npm run preparar && electron-builder --win",
    "dist:mac": "npm run preparar && electron-builder --mac",
    "dist:linux": "npm run preparar && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  }
}
