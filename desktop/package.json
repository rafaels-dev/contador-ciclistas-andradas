{
  "name": "contador-trafego",
  "productName": "Traffic Counter",
  "desktopName": "contador-trafego.desktop",
  "version": "0.0.9",
  "description": "Counting cyclists, pedestrians and vehicles with human review",
  "homepage": "https://github.com/rafaels-dev/contador-ciclistas-andradas",
  "author": "Rafael Schettino <rcschettino@gmail.com>",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "resources": "node scripts/prepare.mjs",
    "start": "electron .",
    "test": "node --test",
    "dist": "npm run resources && electron-builder",
    "dist:win": "npm run resources && electron-builder --win",
    "dist:mac": "npm run resources && electron-builder --mac",
    "dist:linux": "npm run resources && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
